{
  "name": "heraliz-launcher",
  "version": "1.15.0",
  "productName": "HeraliZ Launcher",
  "description": "Launcher HeraliZ — survie Minecraft DayZ",
  "author": "Daniel Scalzi (https://github.com/dscalzi/)",
  "license": "UNLICENSED",
  "homepage": "https://heraliz.fr",
