  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "eslint": "^8.57.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeraliZ/HeraliZ-ServeurMain.git"
