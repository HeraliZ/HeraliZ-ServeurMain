    "helios-distribution-types": "1.3.0",
    "js-yaml": "4.3.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "electron": "44.10.1",
    "electron-builder": "26.15.3",
    "eslint": "9.39.5",
    "globals": "16.5.0"
  }
}
