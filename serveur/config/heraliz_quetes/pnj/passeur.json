  "ambiance": [
    {
      "fr": "Chaque traversée a un prix.",
      "en": "Every crossing has a price.",
      "ru": "У каждого рейса своя цена."
    },
    {
      "fr": "Des armes du continent. Propres, sans histoire.",
      "en": "Guns from the mainland. Clean, no history.",
      "ru": "Оружие с материка. Чистое, без истории."
    },
    {
      "fr": "Je ne fais pas crédit.",
      "en": "I don't do credit.",
      "ru": "В долг не даю."
    }
  ],
  "presentation": {
    "fr": "Tu veux une arme sans fouiller toute l'île ? Je les fais passer du continent, par la mer, de nuit. Pistolets, mitraillettes, fusils à pompe, et les balles qui vont avec. C'est cher : chaque traversée a un prix.",
    "en": "Want a gun without searching the whole island? I bring them over from the mainland, by sea, at night. Pistols, SMGs, shotguns, and the rounds to go with them. It's expensive: every crossing has a price.",
    "ru": "Хочешь ствол, не обыскивая весь остров? Я переправляю их с материка, морем, по ночам. Пистолеты, пистолеты-пулемёты, дробовики и патроны к ним. Дорого: у каждого рейса своя цена."
  },
  "accueil": {
    "inconnu": {
      "fr": "Des armes et des balles, payées en hérals. Je ne fais pas crédit.",
      "en": "Guns and rounds, paid in herals. I don't do credit.",
      "ru": "Оружие и патроны за гералы. В долг не даю."
    },
    "connu": {
      "fr": "Encore toi ? Il me reste quelques caisses de la dernière traversée.",
      "en": "You again? I've got a few crates left from the last crossing.",
      "ru": "Снова ты? У меня осталось несколько ящиков с последнего рейса."
    }
  },
