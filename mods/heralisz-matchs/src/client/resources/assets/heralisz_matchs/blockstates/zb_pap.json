{
  "multipart": [
    {"when": {"partie": "0", "facing": "south"}, "apply": {"model": "heralisz_matchs:block/zb_pap_corps"}},
    {"when": {"partie": "0", "facing": "west"}, "apply": {"model": "heralisz_matchs:block/zb_pap_corps", "y": 90}},
    {"when": {"partie": "0", "facing": "north"}, "apply": {"model": "heralisz_matchs:block/zb_pap_corps", "y": 180}},
    {"when": {"partie": "0", "facing": "east"}, "apply": {"model": "heralisz_matchs:block/zb_pap_corps", "y": 270}},
    {"when": {"partie": "1|2|3|4|5"}, "apply": {"model": "heralisz_matchs:block/zb_vide"}}
  ]
}
