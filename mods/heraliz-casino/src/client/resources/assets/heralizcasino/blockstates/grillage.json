{
  "multipart": [
    { "apply": { "model": "heralizcasino:block/grillage_post" } },
    { "when": { "north": "true" }, "apply": { "model": "heralizcasino:block/grillage_side" } },
    { "when": { "east": "true" }, "apply": { "model": "heralizcasino:block/grillage_side", "y": 90 } },
    { "when": { "south": "true" }, "apply": { "model": "heralizcasino:block/grillage_side_alt" } },
    { "when": { "west": "true" }, "apply": { "model": "heralizcasino:block/grillage_side_alt", "y": 90 } },
    { "when": { "north": "false" }, "apply": { "model": "heralizcasino:block/grillage_noside" } },
    { "when": { "east": "false" }, "apply": { "model": "heralizcasino:block/grillage_noside_alt" } },
    { "when": { "south": "false" }, "apply": { "model": "heralizcasino:block/grillage_noside_alt", "y": 90 } },
    { "when": { "west": "false" }, "apply": { "model": "heralizcasino:block/grillage_noside", "y": 270 } }
  ]
}