{
 "multipart": [
  {
   "apply": {
    "model": "heraliz_decors:block/balustrade_bois_poteau"
   }
  },
  {
   "apply": {
    "model": "heraliz_decors:block/balustrade_bois_cote",
    "uvlock": true
   },
   "when": {
    "north": "true"
   }
  },
  {
   "apply": {
    "model": "heraliz_decors:block/balustrade_bois_cote",
    "uvlock": true,
    "y": 90
   },
   "when": {
    "east": "true"
   }
  },
  {
   "apply": {
    "model": "heraliz_decors:block/balustrade_bois_cote",
    "uvlock": true,
    "y": 180
   },
   "when": {
    "south": "true"
   }
  },
  {
   "apply": {
    "model": "heraliz_decors:block/balustrade_bois_cote",
    "uvlock": true,
    "y": 270
   },
   "when": {
    "west": "true"
   }
  }
 ]
}